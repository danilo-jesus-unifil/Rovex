import { ListView } from "std-widgets.slint";
import { DesignTokens } from "./design_tokens.slint";
import { LocationRow, FileRow, TabRow } from "./data.slint";
import { RovexToolbar } from "./toolbars.slint";
import { ContextMenuOverlay, OperationDialogOverlay, PropertiesDialogOverlay } from "./overlays.slint";
import { RovexFileList } from "./file_list.slint";

export { DesignTokens } from "./design_tokens.slint";
export { LocationRow, FileRow, TabRow } from "./data.slint";

export component MainWindow inherits Window {
    in-out property <string> current-path;
    in-out property <string> filter-text;
    in-out property <[TabRow]> tabs;
    in-out property <[FileRow]> entries;
    in-out property <[LocationRow]> locations;
    in-out property <string> status-text;
    in-out property <string> empty-state-text;
    in-out property <bool> external-drop-active: false;
    in-out property <bool> search-active: false;
    in-out property <bool> preview-visible: false;
    in-out property <image> preview-image;
    in-out property <string> preview-text;
    in-out property <string> preview-title;
    in-out property <string> preview-status;
    in-out property <int> sidebar-focus-index: -1;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <int> selection-count: 0;
    in-out property <int> focused-row-index: -1;
    in-out property <int> sort-column: 1;
    in-out property <bool> sort-ascending: true;
    in-out property <bool> show-hidden-files: false;
    in-out property <bool> operation-dialog-visible: false;
    in-out property <bool> operation-busy: false;
    in-out property <bool> operation-close-only: false;
    in-out property <bool> operation-needs-input: false;
    in-out property <bool> context-menu-visible: false;
    in-out property <string> context-menu-target-name;
    in-out property <bool> properties-visible: false;
    in-out property <string> properties-title;
    in-out property <[string]> properties-lines;
    in-out property <bool> context-menu-can-jxl: false;
    in-out property <bool> context-menu-can-opus: false;
    in-out property <bool> context-menu-can-png: false;
    in-out property <bool> context-menu-can-flac: false;
    in-out property <bool> context-menu-can-terminal: false;
    in-out property <bool> context-menu-can-open: false;
    in-out property <bool> context-menu-can-open-with: false;
    in-out property <string> operation-dialog-title;
    in-out property <string> operation-dialog-message;
    in-out property <string> operation-dialog-input;
    in-out property <int> operation-progress: 0;
    in-out property <string> operation-progress-text;

    callback back-requested();
    callback forward-requested();
    callback refresh-requested();
    callback new-tab-requested();
    callback select-tab(int);
    callback close-tab(int);
    callback navigate-to-location(int);
    callback navigate-up();
    callback navigate-to(string);
    callback filter-changed(string);
    callback recursive-search-requested();
    callback recursive-search-cancelled();
    callback preview-dismissed();
    callback select-row(int, bool, bool);
    callback sort-requested(int);
    callback toggle-hidden-files-requested();
    callback new-folder-requested();
    callback clipboard-copy-requested();
    callback clipboard-cut-requested();
    callback clipboard-paste-requested();
    callback select-all();
    callback activate(int);
    callback copy-requested();
    callback move-requested();
    callback rename-requested();
    callback delete-requested();
    callback operation-confirmed();
    callback operation-cancelled();
    callback operation-dismissed();
    callback context-menu-requested(int);
    callback context-menu-dismissed();
    callback context-menu-copy-requested();
    callback context-menu-move-requested();
    callback context-menu-rename-requested();
    callback context-menu-delete-requested();
    callback context-menu-properties-requested();
    callback context-menu-terminal-requested();
    callback context-menu-open-requested();
    callback context-menu-open-with-requested();
    callback drop-can-drop(data-transfer) -> DragAction;
    callback drop-received(data-transfer) -> DragAction;
    callback context-menu-convert-jxl-requested();
    callback context-menu-convert-opus-requested();
    callback context-menu-convert-png-requested();
    callback context-menu-convert-flac-requested();

    title: "Rovex";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: DesignTokens.window-background;

    VerticalLayout {
        padding: DesignTokens.page-padding;
        spacing: DesignTokens.layout-gap;

        toolbar := RovexToolbar {
            current-path <=> root.current-path;
            filter-text <=> root.filter-text;
            tabs <=> root.tabs;
            selection-count: root.selection-count;
            can-go-back: root.can-go-back;
            can-go-forward: root.can-go-forward;
            operation-busy: root.operation-busy;
            show-hidden-files: root.show-hidden-files;
            search-active: root.search-active;
            back-requested => { root.back-requested(); }
            forward-requested => { root.forward-requested(); }
            refresh-requested => { root.refresh-requested(); }
            new-tab-requested => { root.new-tab-requested(); }
            select-tab(index) => { root.select-tab(index); }
            close-tab(index) => { root.close-tab(index); }
            navigate-up => { root.navigate-up(); }
            navigate-to(path) => { root.navigate-to(path); }
            filter-changed(text) => { root.filter-changed(text); }
            recursive-search-requested => { root.recursive-search-requested(); }
            recursive-search-cancelled => { root.recursive-search-cancelled(); }
            toggle-hidden-files-requested => { root.toggle-hidden-files-requested(); }
            new-folder-requested => { root.new-folder-requested(); }
            copy-requested => { root.copy-requested(); }
            move-requested => { root.move-requested(); }
            rename-requested => { root.rename-requested(); }
            delete-requested => { root.delete-requested(); }
        }

        HorizontalLayout {
            spacing: DesignTokens.content-gap;
            vertical-stretch: 1;
            Rectangle {
                width: DesignTokens.sidebar-width;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: DesignTokens.radius-medium;
                clip: true;
                VerticalLayout {
                    padding: DesignTokens.sidebar-padding;
                    spacing: DesignTokens.sidebar-inner-gap;
                    Text {
                        text: "Locais";
                        color: DesignTokens.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        height: DesignTokens.sidebar-title-height;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 1px;
                        background: DesignTokens.border-subtle;
                    }
                    sidebar-focus := FocusScope {
                        vertical-stretch: 1;
                        focus-on-click: true;
                        key-pressed(event) => {
                            if (root.locations.length == 0) {
                                reject
                            } else if (event.text == Key.UpArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index <= 0 ? 0 : root.sidebar-focus-index - 1;
                                accept
                            } else if (event.text == Key.DownArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index >= root.locations.length - 1 ? root.locations.length - 1 : root.sidebar-focus-index + 1;
                                accept
                            } else if ((event.text == "\n" || event.text == Key.Space) && root.sidebar-focus-index >= 0) {
                                root.navigate-to-location(root.sidebar-focus-index);
                                accept
                            } else {
                                reject
                            }
                        }
                        ListView {
                            width: 100%;
                            height: 100%;
                            for location[index] in root.locations: Rectangle {
                                height: DesignTokens.sidebar-row-height;
                                border-radius: DesignTokens.radius-medium;
                                background: location.path == root.current-path ? DesignTokens.surface-selected : ((sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.surface-secondary : (sidebar-touch.has-hover ? DesignTokens.surface-secondary : (Math.mod(index, 2) == 0 ? DesignTokens.surface : DesignTokens.surface-secondary)));
                                accessible-role: list-item;
                                accessible-label: location.label;
                                accessible-item-selectable: true;
                                accessible-item-selected: location.path == root.current-path;
                                accessible-item-index: index;
                                Text {
                                    x: DesignTokens.sidebar-text-inset;
                                    width: parent.width - 2 * DesignTokens.sidebar-text-inset;
                                    height: parent.height;
                                    text: location.label;
                                    color: location.path == root.current-path || (sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.accent : DesignTokens.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                sidebar-touch := TouchArea {
                                    clicked => {
                                        sidebar-focus.focus();
                                        root.sidebar-focus-index = index;
                                        root.navigate-to-location(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: DesignTokens.content-gap;
                horizontal-stretch: 1;
                Rectangle {
                    vertical-stretch: 1;
                    background: DesignTokens.surface;
                    border-width: 1px;
                    border-color: DesignTokens.border;
                    border-radius: DesignTokens.radius-medium;
                    clip: true;
                    RovexFileList {
                        width: 100%;
                        height: 100%;
                            entries <=> root.entries;
                            status-text <=> root.status-text;
                            empty-state-text <=> root.empty-state-text;
                            focused-row-index <=> root.focused-row-index;
                            sort-column <=> root.sort-column;
                            sort-ascending <=> root.sort-ascending;
                            back-requested => { root.back-requested(); }
                            forward-requested => { root.forward-requested(); }
                            navigate-up => { root.navigate-up(); }
                            focus-path-requested => { toolbar.focus-path(); }
                            focus-filter-requested => { toolbar.focus-filter(); }
                            sort-requested(column) => { root.sort-requested(column); }
                            select-row(index, control, shift) => { root.select-row(index, control, shift); }
                            select-all => { root.select-all(); }
                            activate(index) => { root.activate(index); }
                            rename-requested => { root.rename-requested(); }
                            delete-requested => { root.delete-requested(); }
                            new-folder-requested => { root.new-folder-requested(); }
                            clipboard-copy-requested => { root.clipboard-copy-requested(); }
                            clipboard-cut-requested => { root.clipboard-cut-requested(); }
                            clipboard-paste-requested => { root.clipboard-paste-requested(); }
                            context-menu-requested(index) => { root.context-menu-requested(index); }
                        }
                    if root.preview-visible: Rectangle {
                        x: parent.width - 292px;
                        y: 0px;
                        width: 280px;
                            height: 100%;
                            horizontal-stretch: 0;
                            background: DesignTokens.surface-secondary;
                            border-width: 1px;
                            border-color: DesignTokens.border;
                            border-radius: DesignTokens.radius-medium;
                            clip: true;
                            VerticalLayout {
                                padding: DesignTokens.sidebar-padding;
                                spacing: DesignTokens.control-gap;
                                HorizontalLayout {
                                    height: 30px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.preview-title;
                                        color: DesignTokens.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea {
                                        width: 28px;
                                        height: 28px;
                                        clicked => { root.preview-dismissed(); }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "×";
                                            color: DesignTokens.text-secondary;
                                            font-size: 18px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: DesignTokens.border-subtle;
                                }
                                if root.preview-text != "": Flickable {
                                    width: 100%;
                                    height: 240px;
                                    viewport-width: self.width;
                                    viewport-height: self.height;
                                    Text {
                                        width: parent.width;
                                        height: self.preferred-height;
                                        text: root.preview-text;
                                        color: DesignTokens.text-primary;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-alignment: top;
                                    }
                                }
                                if root.preview-text == "": Image {
                                    width: 100%;
                                    height: 240px;
                                    source: root.preview-image;
                                    image-fit: contain;
                                }
                                Text {
                                    width: 100%;
                                    horizontal-alignment: center;
                                    text: root.preview-status;
                                    color: DesignTokens.text-secondary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    drop-target := DropArea {
                        width: 100%;
                        height: 100%;
                        enabled: !root.operation-dialog-visible;
                        can-drop(event) => { root.drop-can-drop(event.data); }
                        dropped(event) => {
                            root.drop-received(event.data);
                            return event.proposed-action;
                        }
                    }
                    if root.external-drop-active: Rectangle {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        height: 56px;
                        background: #1d4ed866;
                        border-width: 1px;
                        border-color: DesignTokens.accent;
                        border-radius: DesignTokens.radius-medium;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: "Solte para copiar na pasta atual";
                            color: DesignTokens.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.context-menu-visible && !root.operation-dialog-visible: ContextMenuOverlay {
        target-name: root.context-menu-target-name;
        can-jxl: root.context-menu-can-jxl;
        can-opus: root.context-menu-can-opus;
        can-png: root.context-menu-can-png;
        can-flac: root.context-menu-can-flac;
        can-terminal: root.context-menu-can-terminal;
        can-open: root.context-menu-can-open;
        can-open-with: root.context-menu-can-open-with;
        dismissed => { root.context-menu-dismissed(); }
        copy-requested => { root.context-menu-copy-requested(); }
        move-requested => { root.context-menu-move-requested(); }
        rename-requested => { root.context-menu-rename-requested(); }
        delete-requested => { root.context-menu-delete-requested(); }
        properties-requested => { root.context-menu-properties-requested(); }
        terminal-requested => { root.context-menu-terminal-requested(); }
        open-requested => { root.context-menu-open-requested(); }
        open-with-requested => { root.context-menu-open-with-requested(); }
        convert-jxl-requested => { root.context-menu-convert-jxl-requested(); }
        convert-opus-requested => { root.context-menu-convert-opus-requested(); }
        convert-png-requested => { root.context-menu-convert-png-requested(); }
        convert-flac-requested => { root.context-menu-convert-flac-requested(); }
    }

    if root.properties-visible && !root.operation-dialog-visible: PropertiesDialogOverlay {
        title: root.properties-title;
        lines: root.properties-lines;
        dismissed => { root.properties-visible = false; }
    }

    if root.operation-dialog-visible: OperationDialogOverlay {
        busy: root.operation-busy;
        close-only: root.operation-close-only;
        needs-input: root.operation-needs-input;
        title: root.operation-dialog-title;
        message: root.operation-dialog-message;
        input <=> root.operation-dialog-input;
        progress: root.operation-progress;
        progress-text: root.operation-progress-text;
        confirmed => { root.operation-confirmed(); }
        cancelled => { root.operation-cancelled(); }
        dismissed => { root.operation-dismissed(); }
    }
}
