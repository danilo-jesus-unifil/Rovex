import { Button, LineEdit, ListView } from "std-widgets.slint";

export global DesignTokens {
    out property <color> window-background: #f4f5f7;
    out property <color> surface: #ffffff;
    out property <color> surface-secondary: #f7f8fa;
    out property <color> surface-selected: #dbeafe;
    out property <color> surface-dialog: #ffffff;
    out property <color> surface-danger: #fef2f2;
    out property <color> border: #d9dde3;
    out property <color> text-primary: #1f2937;
    out property <color> text-secondary: #6b7280;
    out property <color> text-muted: #697386;
    out property <color> accent: #2563eb;
    out property <color> danger: #b91c1c;
    out property <length> page-padding: 12px;
    out property <length> layout-gap: 10px;
    out property <length> control-gap: 8px;
    out property <length> content-gap: 10px;
    out property <length> toolbar-height: 34px;
    out property <length> sidebar-inner-gap: 6px;
    out property <length> sidebar-title-height: 24px;
    out property <length> sidebar-text-inset: 10px;
    out property <length> status-height: 22px;
    out property <length> filter-width: 260px;
    out property <length> sidebar-width: 190px;
    out property <length> sidebar-padding: 10px;
    out property <length> sidebar-row-height: 34px;
    out property <length> operation-toolbar-height: 34px;
    out property <length> file-row-height: 38px;
    out property <length> file-row-padding: 12px;
    out property <length> file-column-gap: 12px;
    out property <length> radius-small: 4px;
}

export struct LocationRow {
    label: string,
    path: string,
}

export struct FileRow {
    key: string,
    name: string,
    kind: string,
    details: string,
    is-directory: bool,
    selected: bool,
}

export component MainWindow inherits Window {
    in-out property <string> current-path;
    in-out property <string> filter-text;
    in-out property <[FileRow]> entries;
    in-out property <[LocationRow]> locations;
    in-out property <string> status-text;
    in-out property <string> empty-state-text;
    in-out property <int> sidebar-focus-index: -1;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <int> selection-count: 0;
    in-out property <bool> operation-dialog-visible: false;
    in-out property <bool> operation-busy: false;
    in-out property <bool> operation-close-only: false;
    in-out property <bool> operation-needs-input: false;
    in-out property <string> operation-dialog-title;
    in-out property <string> operation-dialog-message;
    in-out property <string> operation-dialog-input;
    in-out property <int> operation-progress: 0;
    in-out property <string> operation-progress-text;

    callback back-requested();
    callback forward-requested();
    callback refresh-requested();
    callback navigate-to-location(int);
    callback navigate-up();
    callback navigate-to(string);
    callback filter-changed(string);
    callback select-row(int, bool, bool);
    callback select-all();
    callback activate(int);
    callback copy-requested();
    callback move-requested();
    callback rename-requested();
    callback delete-requested();
    callback operation-confirmed();
    callback operation-cancelled();
    callback operation-dismissed();

    title: "Rovex";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: DesignTokens.window-background;

    VerticalLayout {
        padding: DesignTokens.page-padding;
        spacing: DesignTokens.layout-gap;

            HorizontalLayout {
                spacing: DesignTokens.control-gap;
                height: DesignTokens.toolbar-height;

            Button {
                text: "←";
                enabled: root.can-go-back;
                accessible-label: "Voltar no histórico";
                clicked => { root.back-requested(); }
            }

            Button {
                text: "→";
                enabled: root.can-go-forward;
                accessible-label: "Avançar no histórico";
                clicked => { root.forward-requested(); }
            }

            Button {
                text: "↑";
                accessible-label: "Subir para a pasta pai";
                clicked => { root.navigate-up(); }
            }

            LineEdit {
                text <=> root.current-path;
                placeholder-text: "Caminho da pasta";
                accepted => { root.navigate-to(self.text); }
            }

            LineEdit {
                width: DesignTokens.filter-width;
                text <=> root.filter-text;
                placeholder-text: "Filtrar nesta pasta";
                accessible-label: "Filtrar itens da pasta atual";
                edited => { root.filter-changed(self.text); }
            }

            Button {
                text: "Atualizar";
                accessible-label: "Atualizar listagem";
                clicked => { root.refresh-requested(); }
            }

        }

        HorizontalLayout {
            spacing: DesignTokens.control-gap;
            height: DesignTokens.operation-toolbar-height;

            Button {
                text: "Copiar";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Copiar itens selecionados";
                clicked => { root.copy-requested(); }
            }

            Button {
                text: "Mover";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Mover itens selecionados";
                clicked => { root.move-requested(); }
            }

            Button {
                text: "Renomear";
                enabled: root.selection-count == 1 && !root.operation-busy;
                accessible-label: "Renomear item selecionado";
                clicked => { root.rename-requested(); }
            }

            Button {
                text: "Excluir";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Excluir itens selecionados";
                clicked => { root.delete-requested(); }
            }
        }

        HorizontalLayout {
            spacing: DesignTokens.content-gap;
            vertical-stretch: 1;

            Rectangle {
                width: DesignTokens.sidebar-width;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: DesignTokens.radius-small;
                VerticalLayout {
                    padding: DesignTokens.sidebar-padding;
                    spacing: DesignTokens.sidebar-inner-gap;
                    Text {
                        text: "Locais";
                        color: DesignTokens.text-primary;
                        height: DesignTokens.sidebar-title-height;
                    }
                    sidebar-focus := FocusScope {
                        vertical-stretch: 1;
                        focus-on-click: true;
                        key-pressed(event) => {
                            if (root.locations.length == 0) {
                                reject
                            } else if (event.text == Key.UpArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index <= 0 ? 0 : root.sidebar-focus-index - 1;
                                accept
                            } else if (event.text == Key.DownArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index >= root.locations.length - 1 ? root.locations.length - 1 : root.sidebar-focus-index + 1;
                                accept
                            } else if ((event.text == "\n" || event.text == Key.Space) && root.sidebar-focus-index >= 0) {
                                root.navigate-to-location(root.sidebar-focus-index);
                                accept
                            } else {
                                reject
                            }
                        }
                        ListView {
                            width: 100%;
                            height: 100%;
                            for location[index] in root.locations: Rectangle {
                                height: DesignTokens.sidebar-row-height;
                                background: location.path == root.current-path ? DesignTokens.surface-selected : ((sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.surface-secondary : (sidebar-touch.has-hover ? DesignTokens.surface-secondary : (Math.mod(index, 2) == 0 ? DesignTokens.surface : DesignTokens.surface-secondary)));
                                accessible-role: list-item;
                                accessible-label: location.label;
                                accessible-item-selectable: true;
                                accessible-item-selected: location.path == root.current-path;
                                accessible-item-index: index;
                                Text {
                                    x: DesignTokens.sidebar-text-inset;
                                    width: parent.width - 2 * DesignTokens.sidebar-text-inset;
                                    height: parent.height;
                                    text: location.label;
                                    color: location.path == root.current-path || (sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.accent : DesignTokens.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                sidebar-touch := TouchArea {
                                    clicked => {
                                        sidebar-focus.focus();
                                        root.sidebar-focus-index = index;
                                        root.navigate-to-location(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: DesignTokens.content-gap;
                horizontal-stretch: 1;
                Rectangle {
                    background: DesignTokens.surface;
                    border-width: 1px;
                    border-color: DesignTokens.border;
                    border-radius: DesignTokens.radius-small;
                    vertical-stretch: 1;

                    focus-scope := FocusScope {
                width: 100%;
                height: 100%;
                focus-on-click: true;
                key-pressed(event) => {
                    if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                        root.select-all();
                        accept
                    }
                    reject
                }

                    ListView {
                        width: 100%;
                        height: 100%;
                    for entry[index] in root.entries: Rectangle {
                        height: DesignTokens.file-row-height;
                        background: entry.selected ? DesignTokens.surface-selected : (Math.mod(index, 2) == 0 ? DesignTokens.surface : DesignTokens.surface-secondary);
                        accessible-role: list-item;
                        accessible-label: entry.selected ? "Selecionado: " + entry.name : entry.name;

                        HorizontalLayout {
                            padding-left: DesignTokens.file-row-padding;
                            padding-right: DesignTokens.file-row-padding;
                            spacing: DesignTokens.file-column-gap;

                            Text {
                                width: 64px;
                                text: entry.kind;
                                color: entry.is-directory ? DesignTokens.accent : DesignTokens.text-muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: entry.name;
                                color: DesignTokens.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: entry.details;
                                color: DesignTokens.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                    focus-scope.focus();
                                    root.select-row(index, event.modifiers.control, event.modifiers.shift);
                                    if (!event.modifiers.control && !event.modifiers.shift) {
                                        root.activate(index);
                                    }
                                }
                            }
                        }
                    }
                    }
                    Text {
                        visible: root.empty-state-text != "";
                        x: 24px;
                        y: 24px;
                        width: parent.width - 48px;
                        text: root.empty-state-text;
                        color: DesignTokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: root.status-text;
                    color: DesignTokens.text-secondary;
                    height: DesignTokens.status-height;
                    overflow: elide;
                }
            }
        }
    }

    if root.operation-dialog-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000066;
        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            x: (parent.width - min(parent.width - 32px, 560px)) / 2;
            y: (parent.height - min(parent.height - 32px, 330px)) / 2;
            width: min(parent.width - 32px, 560px);
            height: min(parent.height - 32px, 330px);
            background: DesignTokens.surface-dialog;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: DesignTokens.radius-small;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.operation-dialog-title;
                    color: DesignTokens.text-primary;
                    font-size: 18px;
                    height: 26px;
                }

                Text {
                    text: root.operation-dialog-message;
                    color: DesignTokens.text-secondary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    overflow: elide;
                }

                LineEdit {
                    visible: root.operation-needs-input && !root.operation-busy && !root.operation-close-only;
                    text <=> root.operation-dialog-input;
                    placeholder-text: "Caminho ou novo nome";
                    accessible-label: "Entrada da operação";
                }

                Rectangle {
                    visible: root.operation-busy;
                    height: 54px;
                    background: DesignTokens.surface-secondary;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;
                        Text {
                            text: root.operation-progress-text;
                            color: DesignTokens.text-secondary;
                            height: 18px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 8px;
                            background: DesignTokens.border;
                            Rectangle {
                                width: parent.width * root.operation-progress / 100;
                                height: parent.height;
                                background: DesignTokens.accent;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 36px;
                    spacing: DesignTokens.control-gap;
                    horizontal-stretch: 1;
                    Button {
                        text: root.operation-busy ? "Cancelar" : (root.operation-close-only ? "Fechar" : "Confirmar");
                        accessible-label: root.operation-busy ? "Cancelar operação" : (root.operation-close-only ? "Fechar resultado" : "Confirmar operação");
                        clicked => {
                            if (root.operation-busy) {
                                root.operation-cancelled();
                            } else if (root.operation-close-only) {
                                root.operation-dismissed();
                            } else {
                                root.operation-confirmed();
                            }
                        }
                    }
                    Button {
                        visible: !root.operation-busy && !root.operation-close-only;
                        text: "Voltar";
                        clicked => { root.operation-dismissed(); }
                    }
                }
            }
        }
    }
}
