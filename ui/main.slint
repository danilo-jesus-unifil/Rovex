import { ListView } from "std-widgets.slint";

export global DesignTokens {
    out property <color> window-background: #0f141a;
    out property <color> surface: #171d24;
    out property <color> surface-secondary: #1d252e;
    out property <color> surface-selected: #263f63;
    out property <color> surface-dialog: #1b232c;
    out property <color> surface-danger: #42252b;
    out property <color> surface-menu: #1a222b;
    out property <color> input-background: #121820;
    out property <color> control-background: #202a34;
    out property <color> control-hover: #2a3948;
    out property <color> control-pressed: #345477;
    out property <color> control-disabled: #252b32;
    out property <color> border: #35424f;
    out property <color> border-strong: #4a5a6b;
    out property <color> overlay: #00000099;
    out property <color> text-primary: #f1f5f9;
    out property <color> text-secondary: #adbac8;
    out property <color> text-muted: #8190a0;
    out property <color> text-disabled: #647181;
    out property <color> accent: #79adff;
    out property <color> accent-strong: #4b8ff5;
    out property <color> accent-text: #071629;
    out property <color> danger: #ff858e;
    out property <length> page-padding: 12px;
    out property <length> layout-gap: 10px;
    out property <length> control-gap: 8px;
    out property <length> content-gap: 10px;
    out property <length> toolbar-height: 34px;
    out property <length> toolbar-gap: 10px;
    out property <length> toolbar-button-width: 42px;
    out property <length> toolbar-refresh-width: 92px;
    out property <length> sidebar-inner-gap: 6px;
    out property <length> sidebar-title-height: 24px;
    out property <length> sidebar-text-inset: 10px;
    out property <length> status-height: 22px;
    out property <length> filter-width: 260px;
    out property <length> sidebar-width: 190px;
    out property <length> sidebar-padding: 10px;
    out property <length> sidebar-row-height: 34px;
    out property <length> operation-toolbar-height: 34px;
    out property <length> file-row-height: 38px;
    out property <length> file-row-padding: 12px;
    out property <length> file-column-gap: 12px;
    out property <length> radius-small: 4px;
}

component RovexButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;

    height: 34px;
    border-width: 1px;
    border-radius: DesignTokens.radius-small;
    border-color: root.enabled ? DesignTokens.border-strong : DesignTokens.border;
    background: !root.enabled ? DesignTokens.control-disabled : (button-touch.pressed ? DesignTokens.control-pressed : (button-touch.has-hover ? DesignTokens.control-hover : DesignTokens.control-background));
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    forward-focus: button-focus;

    button-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;
        key-pressed(event) => {
            if (root.enabled && (event.text == "\\n" || event.text == Key.Space)) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
        button-touch := TouchArea {
            clicked => {
                if (root.enabled) {
                    root.clicked();
                }
            }
        }
        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.enabled ? DesignTokens.text-primary : DesignTokens.text-disabled;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component RovexLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    callback accepted;
    callback edited;

    height: 34px;
    border-width: 1px;
    border-radius: DesignTokens.radius-small;
    accessible-role: text-input;
    border-color: editor.has-focus ? DesignTokens.accent : DesignTokens.border;
    background: DesignTokens.input-background;
    clip: true;

    editor := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        color: DesignTokens.text-primary;
        selection-foreground-color: DesignTokens.accent-text;
        selection-background-color: DesignTokens.accent;
        vertical-alignment: center;
        accessible-role: text-input;
        accessible-label: root.accessible-label;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    if editor.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder-text;
        color: DesignTokens.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }
}

export struct LocationRow {
    label: string,
    path: string,
}

export struct FileRow {
    key: string,
    name: string,
    kind: string,
    details: string,
    is-directory: bool,
    selected: bool,
}

export component MainWindow inherits Window {
    in-out property <string> current-path;
    in-out property <string> filter-text;
    in-out property <[FileRow]> entries;
    in-out property <[LocationRow]> locations;
    in-out property <string> status-text;
    in-out property <string> empty-state-text;
    in-out property <int> sidebar-focus-index: -1;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <int> selection-count: 0;
    in-out property <int> focused-row-index: -1;
    in-out property <bool> operation-dialog-visible: false;
    in-out property <bool> operation-busy: false;
    in-out property <bool> operation-close-only: false;
    in-out property <bool> operation-needs-input: false;
    in-out property <bool> context-menu-visible: false;
    in-out property <string> context-menu-target-name;
    in-out property <bool> context-menu-can-jxl: false;
    in-out property <bool> context-menu-can-opus: false;
    in-out property <bool> context-menu-can-png: false;
    in-out property <bool> context-menu-can-flac: false;
    in-out property <string> operation-dialog-title;
    in-out property <string> operation-dialog-message;
    in-out property <string> operation-dialog-input;
    in-out property <int> operation-progress: 0;
    in-out property <string> operation-progress-text;

    callback back-requested();
    callback forward-requested();
    callback refresh-requested();
    callback navigate-to-location(int);
    callback navigate-up();
    callback navigate-to(string);
    callback filter-changed(string);
    callback select-row(int, bool, bool);
    callback select-all();
    callback activate(int);
    callback copy-requested();
    callback move-requested();
    callback rename-requested();
    callback delete-requested();
    callback operation-confirmed();
    callback operation-cancelled();
    callback operation-dismissed();
    callback context-menu-requested(int);
    callback context-menu-dismissed();
    callback context-menu-copy-requested();
    callback context-menu-move-requested();
    callback context-menu-rename-requested();
    callback context-menu-delete-requested();
    callback context-menu-convert-jxl-requested();
    callback context-menu-convert-opus-requested();
    callback context-menu-convert-png-requested();
    callback context-menu-convert-flac-requested();

    title: "Rovex";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: DesignTokens.window-background;

    VerticalLayout {
        padding: DesignTokens.page-padding;
        spacing: DesignTokens.layout-gap;

            HorizontalLayout {
                spacing: DesignTokens.toolbar-gap;
                height: DesignTokens.toolbar-height;

                RovexButton {
                    width: DesignTokens.toolbar-button-width;
                    text: "←";
                    enabled: root.can-go-back;
                    accessible-label: "Voltar no histórico";
                    clicked => { root.back-requested(); }
                }

                RovexButton {
                    width: DesignTokens.toolbar-button-width;
                    text: "→";
                    enabled: root.can-go-forward;
                    accessible-label: "Avançar no histórico";
                    clicked => { root.forward-requested(); }
                }

                RovexButton {
                    width: DesignTokens.toolbar-button-width;
                    text: "↑";
                    accessible-label: "Subir para a pasta pai";
                    clicked => { root.navigate-up(); }
                }

                RovexLineEdit {
                    horizontal-stretch: 1;
                    text <=> root.current-path;
                    accessible-label: "Caminho da pasta";
                    placeholder-text: "Caminho da pasta";
                    accepted => { root.navigate-to(self.text); }
                }

                RovexLineEdit {
                    width: DesignTokens.filter-width;
                    text <=> root.filter-text;
                    placeholder-text: "Filtrar nesta pasta";
                    accessible-label: "Filtrar itens da pasta atual";
                    edited => { root.filter-changed(self.text); }
                }

                RovexButton {
                    width: DesignTokens.toolbar-refresh-width;
                    text: "Atualizar";
                    accessible-label: "Atualizar listagem";
                    clicked => { root.refresh-requested(); }
                }
            }

        HorizontalLayout {
            spacing: DesignTokens.control-gap;
            height: DesignTokens.operation-toolbar-height;

            RovexButton {
                text: "Copiar";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Copiar itens selecionados";
                clicked => { root.copy-requested(); }
            }

            RovexButton {
                text: "Mover";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Mover itens selecionados";
                clicked => { root.move-requested(); }
            }

            RovexButton {
                text: "Renomear";
                enabled: root.selection-count == 1 && !root.operation-busy;
                accessible-label: "Renomear item selecionado";
                clicked => { root.rename-requested(); }
            }

            RovexButton {
                text: "Excluir";
                enabled: root.selection-count > 0 && !root.operation-busy;
                accessible-label: "Excluir itens selecionados";
                clicked => { root.delete-requested(); }
            }
        }

        HorizontalLayout {
            spacing: DesignTokens.content-gap;
            vertical-stretch: 1;

            Rectangle {
                width: DesignTokens.sidebar-width;
                background: DesignTokens.surface;
                border-width: 1px;
                border-color: DesignTokens.border;
                border-radius: DesignTokens.radius-small;
                clip: true;
                VerticalLayout {
                    padding: DesignTokens.sidebar-padding;
                    spacing: DesignTokens.sidebar-inner-gap;
                    Text {
                        text: "Locais";
                        color: DesignTokens.text-primary;
                        height: DesignTokens.sidebar-title-height;
                    }
                    sidebar-focus := FocusScope {
                        vertical-stretch: 1;
                        focus-on-click: true;
                        key-pressed(event) => {
                            if (root.locations.length == 0) {
                                reject
                            } else if (event.text == Key.UpArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index <= 0 ? 0 : root.sidebar-focus-index - 1;
                                accept
                            } else if (event.text == Key.DownArrow) {
                                root.sidebar-focus-index = root.sidebar-focus-index >= root.locations.length - 1 ? root.locations.length - 1 : root.sidebar-focus-index + 1;
                                accept
                            } else if ((event.text == "\n" || event.text == Key.Space) && root.sidebar-focus-index >= 0) {
                                root.navigate-to-location(root.sidebar-focus-index);
                                accept
                            } else {
                                reject
                            }
                        }
                        ListView {
                            width: 100%;
                            height: 100%;
                            for location[index] in root.locations: Rectangle {
                                height: DesignTokens.sidebar-row-height;
                                border-radius: DesignTokens.radius-small;
                                background: location.path == root.current-path ? DesignTokens.surface-selected : ((sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.surface-secondary : (sidebar-touch.has-hover ? DesignTokens.surface-secondary : (Math.mod(index, 2) == 0 ? DesignTokens.surface : DesignTokens.surface-secondary)));
                                accessible-role: list-item;
                                accessible-label: location.label;
                                accessible-item-selectable: true;
                                accessible-item-selected: location.path == root.current-path;
                                accessible-item-index: index;
                                Text {
                                    x: DesignTokens.sidebar-text-inset;
                                    width: parent.width - 2 * DesignTokens.sidebar-text-inset;
                                    height: parent.height;
                                    text: location.label;
                                    color: location.path == root.current-path || (sidebar-focus.has-focus && root.sidebar-focus-index == index) ? DesignTokens.accent : DesignTokens.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                sidebar-touch := TouchArea {
                                    clicked => {
                                        sidebar-focus.focus();
                                        root.sidebar-focus-index = index;
                                        root.navigate-to-location(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: DesignTokens.content-gap;
                horizontal-stretch: 1;
                Rectangle {
                    background: DesignTokens.surface;
                    border-width: 1px;
                    border-color: DesignTokens.border;
                    border-radius: DesignTokens.radius-small;
                    vertical-stretch: 1;

                    focus-scope := FocusScope {
                        width: 100%;
                        height: 100%;
                        focus-on-click: true;
                        key-pressed(event) => {
                            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                                root.select-all();
                                root.focused-row-index = -1;
                                accept
                            } else if (event.text == "\n" && root.focused-row-index >= 0) {
                                root.activate(root.focused-row-index);
                                accept
                            } else {
                                reject
                            }
                        }

                        ListView {
                            width: 100%;
                            height: 100%;
                            for entry[index] in root.entries: Rectangle {
                        height: DesignTokens.file-row-height;
                        background: entry.selected ? DesignTokens.surface-selected : (Math.mod(index, 2) == 0 ? DesignTokens.surface : DesignTokens.surface-secondary);
                        accessible-role: list-item;
                        accessible-label: entry.selected ? "Selecionado: " + entry.name : entry.name;

                        HorizontalLayout {
                            padding-left: DesignTokens.file-row-padding;
                            padding-right: DesignTokens.file-row-padding;
                            spacing: DesignTokens.file-column-gap;

                            Text {
                                width: 64px;
                                text: entry.kind;
                                color: entry.is-directory ? DesignTokens.accent : DesignTokens.text-muted;
                                vertical-alignment: center;
                            }

                            Text {
                                text: entry.name;
                                color: DesignTokens.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: entry.details;
                                color: DesignTokens.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                    focus-scope.focus();
                                    root.focused-row-index = index;
                                    root.select-row(index, event.modifiers.control, event.modifiers.shift);
                                } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                    focus-scope.focus();
                                    root.focused-row-index = index;
                                    root.select-row(index, false, false);
                                    root.context-menu-requested(index);
                                }
                            }
                            double-clicked => {
                                root.activate(index);
                            }
                        }
                    }
                    }
                    Text {
                        visible: root.empty-state-text != "";
                        x: 24px;
                        y: 24px;
                        width: parent.width - 48px;
                        text: root.empty-state-text;
                        color: DesignTokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: root.status-text;
                    color: DesignTokens.text-secondary;
                    height: DesignTokens.status-height;
                    overflow: elide;
                }
            }
        }
    }

    if root.context-menu-visible && !root.operation-dialog-visible: FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        focus-on-click: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.context-menu-dismissed();
                accept
            }
            reject
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.context-menu-dismissed(); }
            }
        }

        Rectangle {
            x: 16px;
            y: 58px;
            width: 330px;
            height: 408px;
            background: DesignTokens.surface-menu;
            border-width: 1px;
            border-color: DesignTokens.border-strong;
            border-radius: DesignTokens.radius-small;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Text {
                    text: "Ações — " + root.context-menu-target-name;
                    color: DesignTokens.text-primary;
                    height: 24px;
                    overflow: elide;
                }
                Text {
                    text: "Conversões usam FFmpeg instalado no PATH";
                    color: DesignTokens.text-muted;
                    height: 18px;
                    overflow: elide;
                }

                RovexButton {
                    text: "Copiar";
                    accessible-label: "Copiar item pelo menu contextual";
                    clicked => { root.context-menu-copy-requested(); }
                }
                RovexButton {
                    text: "Mover";
                    accessible-label: "Mover item pelo menu contextual";
                    clicked => { root.context-menu-move-requested(); }
                }
                RovexButton {
                    text: "Renomear";
                    accessible-label: "Renomear item pelo menu contextual";
                    clicked => { root.context-menu-rename-requested(); }
                }
                RovexButton {
                    text: "Excluir";
                    accessible-label: "Excluir item pelo menu contextual";
                    clicked => { root.context-menu-delete-requested(); }
                }

                Rectangle {
                    height: 1px;
                    background: DesignTokens.border;
                }

                RovexButton {
                    text: "Converter para JPEG XL (.jxl)";
                    enabled: root.context-menu-can-jxl;
                    accessible-label: "Converter imagem selecionada para JPEG XL";
                    clicked => { root.context-menu-convert-jxl-requested(); }
                }
                RovexButton {
                    text: "Converter áudio para Opus (.opus)";
                    enabled: root.context-menu-can-opus;
                    accessible-label: "Converter áudio selecionado para Opus";
                    clicked => { root.context-menu-convert-opus-requested(); }
                }
                RovexButton {
                    text: "Converter imagem para PNG (.png)";
                    enabled: root.context-menu-can-png;
                    accessible-label: "Converter imagem selecionada para PNG";
                    clicked => { root.context-menu-convert-png-requested(); }
                }
                RovexButton {
                    text: "Converter áudio para FLAC (.flac)";
                    enabled: root.context-menu-can-flac;
                    accessible-label: "Converter áudio selecionado para FLAC";
                    clicked => { root.context-menu-convert-flac-requested(); }
                }
            }
        }
    }

    if root.operation-dialog-visible: FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        focus-on-click: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.operation-busy) {
                    root.operation-cancelled();
                } else {
                    root.operation-dismissed();
                }
                accept
            }
            reject
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: #00000066;
            TouchArea {
                width: 100%;
                height: 100%;
            }
        }

        Rectangle {
            x: (parent.width - min(parent.width - 32px, 560px)) / 2;
            y: (parent.height - min(parent.height - 32px, 330px)) / 2;
            width: min(parent.width - 32px, 560px);
            height: min(parent.height - 32px, 330px);
            background: DesignTokens.surface-dialog;
            border-width: 1px;
            border-color: DesignTokens.border;
            border-radius: DesignTokens.radius-small;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.operation-dialog-title;
                    color: DesignTokens.text-primary;
                    font-size: 18px;
                    height: 26px;
                }

                Text {
                    text: root.operation-dialog-message;
                    color: DesignTokens.text-secondary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    overflow: elide;
                }

                RovexLineEdit {
                    visible: root.operation-needs-input && !root.operation-busy && !root.operation-close-only;
                    text <=> root.operation-dialog-input;
                    placeholder-text: "Caminho ou novo nome";
                    accessible-label: "Entrada da operação";
                }

                Rectangle {
                    visible: root.operation-busy;
                    height: 54px;
                    background: DesignTokens.surface-secondary;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;
                        Text {
                            text: root.operation-progress-text;
                            color: DesignTokens.text-secondary;
                            height: 18px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 8px;
                            background: DesignTokens.border;
                            Rectangle {
                                width: parent.width * root.operation-progress / 100;
                                height: parent.height;
                                background: DesignTokens.accent;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    height: 36px;
                    spacing: DesignTokens.control-gap;
                    horizontal-stretch: 1;
                    RovexButton {
                        text: root.operation-busy ? "Cancelar" : (root.operation-close-only ? "Fechar" : "Confirmar");
                        accessible-label: root.operation-busy ? "Cancelar operação" : (root.operation-close-only ? "Fechar resultado" : "Confirmar operação");
                        clicked => {
                            if (root.operation-busy) {
                                root.operation-cancelled();
                            } else if (root.operation-close-only) {
                                root.operation-dismissed();
                            } else {
                                root.operation-confirmed();
                            }
                        }
                    }
                    RovexButton {
                        visible: !root.operation-busy && !root.operation-close-only;
                        text: "Voltar";
                        clicked => { root.operation-dismissed(); }
                    }
                }
            }
        }
    }
}
