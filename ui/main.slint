import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct FileRow {
    name: string,
    kind: string,
    details: string,
    is-directory: bool,
}

export component MainWindow inherits Window {
    in-out property <string> current-path;
    in-out property <[FileRow]> entries;
    in-out property <string> status-text;

    callback refresh-requested();
    callback navigate-up();
    callback navigate-to(string);
    callback activate(int);

    title: "Rovex";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: #f4f5f7;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            height: 34px;

            Button {
                text: "↑";
                accessible-label: "Subir para a pasta pai";
                clicked => { root.navigate-up(); }
            }

            LineEdit {
                text <=> root.current-path;
                placeholder-text: "Caminho da pasta";
                accepted => { root.navigate-to(self.text); }
            }

            Button {
                text: "Atualizar";
                accessible-label: "Atualizar listagem";
                clicked => { root.refresh-requested(); }
            }
        }

        Rectangle {
            background: #ffffff;
            border-width: 1px;
            border-color: #d9dde3;
            border-radius: 4px;

            ListView {
                for entry[index] in root.entries: Rectangle {
                    height: 38px;
                    background: Math.mod(index, 2) == 0 ? #ffffff : #f7f8fa;
                    accessible-role: list-item;
                    accessible-label: entry.name;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;

                        Text {
                            width: 64px;
                            text: entry.kind;
                            color: entry.is-directory ? #2563eb : #697386;
                            vertical-alignment: center;
                        }

                        Text {
                            text: entry.name;
                            color: #1f2937;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        Text {
                            text: entry.details;
                            color: #6b7280;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => { root.activate(index); }
                    }
                }
            }
        }

        Text {
            text: root.status-text;
            color: #4b5563;
            height: 22px;
            overflow: elide;
        }
    }
}
