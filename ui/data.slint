export struct LocationRow {
    label: string,
    path: string,
}

export struct FileRow {
    key: string,
    name: string,
    kind: string,
    icon: string,
    details: string,
    modified: string,
    created: string,
    accessed: string,
    is-directory: bool,
    selected: bool,
}

export struct TabRow {
    label: string,
    path: string,
    active: bool,
}
